<% content_for :title, @camp.name %>

<h1><%= @camp.name %></h1>
<p>Capacity: <%= @camp.capacity %></p>

<p>
  <%= link_to "Edit", edit_camp_path(@camp) %>
  ·
  <%= link_to "New reservation", new_camp_reservation_path(@camp) %>
  ·
  <%= link_to "All camps", camps_path %>
</p>

<section class="calendar">
  <h2>Calendar</h2>
  <p class="calendar-nav">
    <%= link_to "←", camp_path(@camp, month: @month_start.prev_month) %>
    <strong><%= @month_start.strftime("%B %Y") %></strong>
    <%= link_to "→", camp_path(@camp, month: @month_start.next_month) %>
  </p>
  <p class="calendar-legend">
    <span class="swatch"></span> free
    <span class="swatch is-full"></span> full
  </p>
  <table>
    <thead>
      <tr>
        <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day| %>
          <th><%= day %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @calendar_weeks.each do |week| %>
        <tr>
          <% week.each do |cell| %>
            <% if cell %>
              <td class="<%= "is-full" if cell[:full] %>">
                <span class="day"><%= cell[:date].day %></span>
                <span class="occ"><%= cell[:occupied] %>/<%= @camp.capacity %></span>
              </td>
            <% else %>
              <td class="is-empty"></td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<h2>Reservations</h2>

<% if @reservations.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>People</th>
        <th>From</th>
        <th>To</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |reservation| %>
        <tr>
          <td><%= link_to reservation.name, reservation %></td>
          <td><%= reservation.amount %></td>
          <td><%= reservation.start_date %></td>
          <td><%= reservation.end_date %></td>
          <td>
            <%= link_to "Edit", edit_reservation_path(reservation) %>
            <%= button_to "Delete", reservation, method: :delete, form: { data: { turbo_confirm: "Delete this reservation?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No reservations yet.</p>
<% end %>
