<% content_for :title, @camp.name %>

<h1><%= @camp.name %></h1>
<p>Capacity: <%= @camp.capacity %></p>

<p>
  <%= link_to "Edit", edit_camp_path(@camp) %>
  ·
  <%= link_to "New reservation", new_camp_reservation_path(@camp) %>
  ·
  <%= link_to "All camps", camps_path %>
</p>

<h2>Reservations</h2>

<% if @reservations.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>People</th>
        <th>From</th>
        <th>To</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |reservation| %>
        <tr>
          <td><%= link_to reservation.name, reservation %></td>
          <td><%= reservation.amount %></td>
          <td><%= reservation.start_date %></td>
          <td><%= reservation.end_date %></td>
          <td>
            <%= link_to "Edit", edit_reservation_path(reservation) %>
            <%= button_to "Delete", reservation, method: :delete, form: { data: { turbo_confirm: "Delete this reservation?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No reservations yet.</p>
<% end %>
